{
  "name": "sts2-review-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Post-run review coach for Slay the Spire 2: an LLM agent over the deterministic deck-fitness engine (MCP).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "coach": "dist/cli.js"
  },
