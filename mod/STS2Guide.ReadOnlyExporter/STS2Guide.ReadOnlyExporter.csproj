<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>STS2GuideReadOnlyExporter</AssemblyName>
    <RootNamespace>STS2Guide.ReadOnlyExporter</RootNamespace>
    <Version>0.1.0</Version>

    <STS2GamePath Condition="'$(STS2GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</STS2GamePath>
    <GodotExePath Condition="'$(GodotExePath)' == ''"></GodotExePath>
    <GameDataDir>$(STS2GamePath)\data_sts2_windows_x86_64</GameDataDir>
    <ArtifactsDir>$(MSBuildProjectDirectory)\artifacts\mod</ArtifactsDir>
    <PackProject>$(MSBuildProjectDirectory)\pack</PackProject>
    <InstallModOnBuild Condition="'$(InstallModOnBuild)' == ''">false</InstallModOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerifyGameAssemblies" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(GameDataDir)\sts2.dll')"
      Text="STS2 assemblies were not found. Copy local.props.example to local.props and set STS2GamePath." />
  </Target>

  <Target Name="PrepareModArtifacts" AfterTargets="Build">
    <MakeDir Directories="$(ArtifactsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ArtifactsDir)" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\STS2GuideReadOnlyExporter.json"
      DestinationFolder="$(ArtifactsDir)" />
    <Exec
      Condition="'$(GodotExePath)' != '' and Exists('$(GodotExePath)')"
      Command="&quot;$(GodotExePath)&quot; --headless --path &quot;$(PackProject)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(ArtifactsDir)\STS2GuideReadOnlyExporter.pck&quot;" />
    <Warning
      Condition="'$(GodotExePath)' == '' or !Exists('$(GodotExePath)')"
      Text="Godot .NET executable not configured; DLL and JSON were built, but PCK packaging was skipped." />
  </Target>

  <Target
    Name="InstallMod"
    AfterTargets="PrepareModArtifacts"
    Condition="'$(InstallModOnBuild)' == 'true'">
    <MakeDir Directories="$(STS2GamePath)\mods" />
    <ItemGroup>
      <BuiltModFiles Include="$(ArtifactsDir)\STS2GuideReadOnlyExporter.dll" />
      <BuiltModFiles Include="$(ArtifactsDir)\STS2GuideReadOnlyExporter.json" />
      <BuiltModFiles
        Include="$(ArtifactsDir)\STS2GuideReadOnlyExporter.pck"
        Condition="Exists('$(ArtifactsDir)\STS2GuideReadOnlyExporter.pck')" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltModFiles)" DestinationFolder="$(STS2GamePath)\mods" />
  </Target>
</Project>
