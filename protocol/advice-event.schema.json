{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sts2-guide.local/protocol/advice-event.schema.json",
  "title": "STS2 Guide Advice Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id", "event_type", "status", "run_id", "sequence",
    "processed_at", "decision_id", "recommendation", "advice_disposition",
    "compatibility", "guide_preferences"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 3 },
    "event_type": {
      "enum": [
        "card_reward",
        "route_choice",
        "merchant",
        "rest_site",
        "neow_choice",
        "event_choice",
        "deck_edit"
      ]
    },
    "status": { "const": "processed" },
    "run_id": { "type": "string", "minLength": 3 },
    "sequence": { "type": "integer", "minimum": 1 },
    "processed_at": { "type": "string", "format": "date-time" },
    "decision_id": { "type": "string", "minLength": 3 },
    "guide_preferences": { "$ref": "#/$defs/guidePreferences" },
    "recommendation": { "$ref": "#/$defs/recommendation" },
    "advice_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "run_id", "decision_id"],
      "properties": {
        "action": { "const": "publish" },
        "run_id": { "type": "string", "minLength": 3 },
        "decision_id": { "type": "string", "minLength": 3 }
      }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "advice": { "$ref": "#/$defs/cardRewardLegacyAdvice" }
  },
  "$defs": {
    "guidePreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_mode"],
      "properties": {
        "route_mode": {
          "enum": ["balanced", "survival", "growth"]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "manifest_version", "release_fingerprint", "guide_version",
        "state_event_schema_version", "producer_id", "producer_version",
        "game_version", "game_assembly_sha256", "capability",
        "capability_status"
      ],
      "properties": {
        "status": { "const": "compatible" },
        "manifest_version": { "const": 2 },
        "release_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "guide_version": { "type": "string", "minLength": 1 },
        "state_event_schema_version": { "const": 9 },
        "producer_id": { "type": "string", "minLength": 1 },
        "producer_version": { "type": "string", "minLength": 1 },
        "game_version": { "type": "string", "minLength": 1 },
        "game_assembly_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability": {
          "enum": [
            "card_reward",
            "route_choice",
            "merchant",
            "rest_site",
            "neow_choice",
            "event_choice",
            "deck_edit"
          ]
        },
        "capability_status": { "const": "enabled" }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "decision_id", "decision_type", "world_sequence",
        "policy_version", "status", "confidence", "recommended_candidate_id",
        "candidates", "data_gaps"
      ],
      "properties": {
        "contract_version": { "enum": [1, 2] },
        "decision_id": { "type": "string", "minLength": 3 },
        "decision_type": {
          "enum": [
            "card_reward",
            "route_choice",
            "merchant_choice",
            "campfire_action",
            "neow_blessing",
            "event_option",
            "deck_edit"
          ]
        },
        "world_sequence": { "type": "integer", "minimum": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["recommend", "skip", "uncertain"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "recommended_candidate_id": { "type": ["string", "null"], "minLength": 1 },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/candidateAssessment" }
        },
        "data_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
        ,
        "presentation": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "uncertain" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "recommended_candidate_id": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "recommend" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "recommended_candidate_id": {
                "type": "string",
                "minLength": 1,
                "not": { "const": "skip" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "skip" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "decision_type": { "const": "card_reward" },
              "recommended_candidate_id": { "const": "skip" }
            }
          }
        },
        {
          "if": {
            "properties": { "decision_type": { "const": "route_choice" } },
            "required": ["decision_type"]
          },
          "then": {
            "required": ["presentation"],
            "properties": {
              "contract_version": { "const": 2 },
              "presentation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "origin_node_id",
                  "primary_path_node_ids",
                  "backup_path_node_ids",
                  "paths"
                ],
                "properties": {
                  "kind": { "const": "route_paths" },
                  "origin_node_id": { "type": ["string", "null"] },
                  "primary_path_node_ids": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "backup_path_node_ids": {
                    "type": "array",
                    "maxItems": 0,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "paths": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/routePath" }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "contract_version": { "const": 1 } },
            "required": ["contract_version"]
          },
          "then": {
            "not": {
              "required": ["presentation"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_type": { "const": "route_choice" },
              "recommended_candidate_id": { "type": "null" }
            },
            "required": ["decision_type", "recommended_candidate_id"]
          },
          "then": {
            "properties": {
              "presentation": {
                "properties": {
                  "primary_path_node_ids": { "maxItems": 0 },
                  "backup_path_node_ids": { "maxItems": 0 },
                  "paths": { "maxItems": 0 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_type": { "const": "route_choice" },
              "recommended_candidate_id": { "type": "string", "minLength": 1 }
            },
            "required": ["decision_type", "recommended_candidate_id"]
          },
          "then": {
            "properties": {
              "presentation": {
                "properties": {
                  "origin_node_id": { "type": "string", "minLength": 1 },
                  "primary_path_node_ids": { "minItems": 1 },
                  "paths": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": { "contract_version": { "const": 2 } },
                "required": ["contract_version"]
              },
              {
                "properties": {
                  "decision_type": { "not": { "const": "route_choice" } }
                },
                "required": ["decision_type"]
              }
            ]
          },
          "then": {
            "not": {
              "required": ["presentation"]
            }
          }
        }
      ]
    },
    "routePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "node_ids", "score"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "candidateAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "label", "display_index", "eligible", "score", "rank",
        "factors", "dimensions", "data_gaps"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "display_index": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "boolean" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "factors": { "type": "array", "items": { "type": "object" } },
        "dimensions": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "immediate_power", "survival", "long_term_growth",
              "resource_efficiency", "deck_burden", "synergy", "route_fit",
              "data_completeness"
            ]
          },
          "additionalProperties": { "type": ["number", "null"] }
        },
        "data_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "eligible": { "const": false } },
            "required": ["eligible"]
          },
          "then": {
            "properties": {
              "score": { "const": null },
              "rank": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": { "score": { "type": "null" } },
            "required": ["score"]
          },
          "then": {
            "properties": { "rank": { "const": null } }
          }
        },
        {
          "if": {
            "properties": { "rank": { "type": "integer" } },
            "required": ["rank"]
          },
          "then": {
            "properties": { "score": { "type": "number" } }
          }
        }
      ]
    },
    "cardRewardLegacyAdvice": {
      "type": "object",
      "required": ["recommendations", "skip_candidate", "recommended_option_index"],
      "properties": {
        "recommended_option_index": { "type": "integer", "minimum": 0, "maximum": 10 },
        "recommendations": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["card_id", "option_index", "score", "known"],
            "properties": {
              "card_id": { "type": "string", "minLength": 1 },
              "option_index": { "type": "integer", "minimum": 0, "maximum": 9 },
              "score": { "type": "number", "minimum": 0, "maximum": 100 },
              "known": { "type": "boolean" }
            }
          }
        },
        "skip_candidate": {
          "type": "object",
          "required": ["choice", "score"],
          "properties": {
            "choice": { "const": "skip" },
            "score": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    }
  }
  ,
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "route_choice" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "route_choice" } },
            "required": ["decision_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "card_reward" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "card_reward" } },
            "required": ["decision_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "merchant" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "merchant_choice" } },
            "required": ["decision_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "rest_site" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "campfire_action" } },
            "required": ["decision_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "neow_choice" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "neow_blessing" } },
            "required": ["decision_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "event_choice" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "event_option" } },
            "required": ["decision_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "deck_edit" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "deck_edit" } },
            "required": ["decision_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "route_choice" } },
            "required": ["decision_type"]
          }
        },
        "required": ["recommendation"]
      },
      "then": {
        "properties": { "event_type": { "const": "route_choice" } }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "card_reward" } },
            "required": ["decision_type"]
          }
        },
        "required": ["recommendation"]
      },
      "then": {
        "properties": { "event_type": { "const": "card_reward" } }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "merchant_choice" } },
            "required": ["decision_type"]
          }
        },
        "required": ["recommendation"]
      },
      "then": {
        "properties": { "event_type": { "const": "merchant" } }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "campfire_action" } },
            "required": ["decision_type"]
          }
        },
        "required": ["recommendation"]
      },
      "then": {
        "properties": { "event_type": { "const": "rest_site" } }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "neow_blessing" } },
            "required": ["decision_type"]
          }
        },
        "required": ["recommendation"]
      },
      "then": {
        "properties": { "event_type": { "const": "neow_choice" } }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "event_option" } },
            "required": ["decision_type"]
          }
        },
        "required": ["recommendation"]
      },
      "then": {
        "properties": { "event_type": { "const": "event_choice" } }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "properties": { "decision_type": { "const": "deck_edit" } },
            "required": ["decision_type"]
          }
        },
        "required": ["recommendation"]
      },
      "then": {
        "properties": { "event_type": { "const": "deck_edit" } }
      }
    }
  ]
}
